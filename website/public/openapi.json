            }
          }
        }
      }
    },
    "/subtitle": {
      "post": {
        "summary": "Generate Subtitle",
        "description": "Genera subtítulos desde `params.script`.\n\n- Si `params.subtitle_style == WORD_BURST` y `params.custom_audio_file` está\n  presente → derivamos timings via TTS sobre el script (best-effort).\n- SRT: derivado de los word_timings del TTS.",
        "operationId": "generate_subtitle_subtitle_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/narratives": {
      "post": {
        "summary": "Get Narrative",
        "description": "Devuelve solo el ScriptDraft delayed-reveal (sin generar video).\n\n- topic: hunters + critic + narrators + judge (sin downstream visual).\n- url:   extract_essence + compose_script.\n- subject: no soportado (no es delayed-reveal).",
        "operationId": "get_narrative_narratives_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoParams"
              }
            }
          },
          "required": true
        },
        "responses": {
