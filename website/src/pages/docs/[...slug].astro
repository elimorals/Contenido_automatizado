---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);

// Derivar title del slug (primer línea del .md o slug si no)
const inferredTitle = doc.body?.match(/^#\s+(.+)$/m)?.[1] ?? doc.id;
const title = doc.data.title ?? inferredTitle;
const description = doc.data.description ?? `${doc.id} — documentación del proyecto contenido`;
---

<DocsLayout title={title} description={description} currentSlug={doc.id}>
  <Content />
</DocsLayout>
