---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada">
  <section class="relative flex min-h-[70vh] items-center justify-center px-4">
    <div class="text-center">
      <p class="cinema-label justify-center inline-flex">Error 404</p>
      <h1
        class="mt-6 font-display text-[clamp(4rem,12vw,9rem)] leading-none text-[var(--color-ink-primary)]"
        style="font-variation-settings: 'opsz' 144, 'SOFT' 100; font-style: italic;"
      >
        cut.
      </h1>
      <p class="mt-6 max-w-md text-[16px] leading-relaxed text-[var(--color-ink-secondary)]">
        La página que buscas no existe — o se fue al cuarto de edición y nunca regresó.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="glow-amber inline-flex items-center gap-2 rounded-[var(--radius-sm)] bg-[var(--color-accent)] px-6 py-3 font-mono text-[13px] font-medium text-[var(--color-surface-base)] no-underline"
        >
          Volver al inicio
        </a>
        <a
          href="/docs"
          class="inline-flex items-center gap-2 rounded-[var(--radius-sm)] border border-[var(--color-line)] px-6 py-3 font-mono text-[13px] text-[var(--color-ink-secondary)] no-underline transition-all hover:border-[var(--color-accent-deep)] hover:text-[var(--color-ink-primary)]"
        >
          Ver documentación
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
