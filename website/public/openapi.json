                }
              }
            }
          }
        }
      }
    },
    "/audio": {
      "post": {
        "summary": "Generate Audio",
        "description": "Genera audio (TTS) desde `params.script`. Devuelve path + word_timings.",
        "operationId": "generate_audio_audio_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoParams"
              }
            }
          },
          "required": true
        },
        "responses": {
