---
const stats = [
  { value: "562", label: "Tests verde", suffix: "" },
  { value: "24", label: "ADRs", suffix: "" },
  { value: "18", label: "Reasoners DAG", suffix: "" },
  { value: "MCP", label: "Agente-driven", suffix: "" },
  { value: "5–60", label: "Min · long-form", suffix: "" },
];
---

<section
  class="relative border-y border-[var(--color-line)] bg-gradient-to-b from-[var(--color-surface-1)]/30 to-[var(--color-surface-base)]"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <dl class="grid grid-cols-2 divide-x divide-[var(--color-line-faint)] sm:grid-cols-5">
      {
        stats.map((s) => (
          <div class="group flex flex-col items-start gap-1.5 py-10 pl-5 first:pl-0 sm:pl-7">
            <dt class="cinema-label">{s.label}</dt>
            <dd class="tabular flex items-baseline gap-1 font-display text-[clamp(2rem,4vw,3.2rem)] leading-none text-[var(--color-ink-primary)] transition-colors group-hover:text-[var(--color-accent)]" style="font-variation-settings: 'opsz' 144, 'SOFT' 60;">
              {s.value}
              <span class="text-[20px] text-[var(--color-accent)]">{s.suffix}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
