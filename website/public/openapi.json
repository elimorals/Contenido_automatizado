              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/hunters": {
      "post": {
        "summary": "Run Hunters",
        "description": "Devuelve los 12 candidates de los 4 hunters (A/B testing externo).\n\nSolo válido si `params.topic` está presente.",
        "operationId": "run_hunters_hunters_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
