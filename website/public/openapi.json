    "/scripts": {
      "post": {
        "summary": "Generate Script",
        "description": "Genera solo el script (sin TTS/video). Dispatch por entry point.\n\n- url     → extract_essence + compose_script (10 reasoners)\n- topic   → hunters + critic + narrators + judge (18 reasoners)\n- subject → 1 LLM call (legacy MPT)",
        "operationId": "generate_script_scripts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/terms": {
      "post": {
        "summary": "Generate Terms",
        "description": "Genera 5-8 search terms para stock footage (Pexels/Pixabay).",
        "operationId": "generate_terms_terms_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoParams"
              }
            }
          },
          "required": true
