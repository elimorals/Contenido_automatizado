---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/seo/JsonLd.astro";

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
  /** OpenGraph type — "website" por default; docs pasan "article". */
  ogType?: "website" | "article";
  /** ISO-8601 — para article pages. */
  publishedTime?: string;
  modifiedTime?: string;
  /** JSON-LD adicional que se inyecta al @graph. Útil para breadcrumbs/article. */
  extraJsonLd?: Array<Record<string, unknown>>;
}

const {
  title,
  description = "Plataforma open source para generación de video con IA: reels cinematográficos, brand-owned con LoRA propia, long-form de 5–60 min. Cinco linajes fusionados, multi-tenant, cost-tracked.",
  showHeader = true,
  ogType = "website",
  publishedTime,
  modifiedTime,
  extraJsonLd = [],
} = Astro.props;

const SITE_NAME = "contenido";
const REPO_URL = "https://github.com/elimorals/Contenido_automatizado";
const TWITTER_HANDLE = "@cipreholding";

const siteUrl = Astro.site ?? new URL("https://contenido.vercel.app");
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = !title
  ? `${SITE_NAME} — plataforma de generación de video con IA`
  : `${title} · ${SITE_NAME}`;

// OG image: usamos un PNG estático para home/docs. Si en el futuro
// queremos por-página, swap a astro-og-canvas.
const ogImageUrl = new URL("/og-image.png", siteUrl).href;
const ogImageAlt = `contenido — ${title ?? "plataforma de generación de video con IA"}`;

// ─── JSON-LD Schema.org ──────────────────────────────────────────────
const organization = {
  "@type": "Organization",
  "@id": new URL("/#organization", siteUrl).href,
  name: "Cipre Holding",
  url: siteUrl.origin + "/",
  sameAs: [REPO_URL, "https://github.com/elimorals"],
};

const webSite = {
  "@type": "WebSite",
  "@id": new URL("/#website", siteUrl).href,
  url: siteUrl.origin + "/",
  name: SITE_NAME,
  description,
  inLanguage: "es",
  publisher: { "@id": organization["@id"] },
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: siteUrl.origin + "/docs?q={search_term_string}",
    },
    "query-input": "required name=search_term_string",
  },
};

const isHome = (Astro.url.pathname || "/") === "/";

// SoftwareSourceCode SOLO en home — es el match que Google Knowledge
// Graph y similares usan para mostrar el repo en el panel.
const softwareSourceCode = isHome
  ? {
      "@type": "SoftwareSourceCode",
      "@id": siteUrl.origin + "/#software",
      name: SITE_NAME,
      description,
      url: siteUrl.origin + "/",
      codeRepository: REPO_URL,
      programmingLanguage: ["Python", "TypeScript", "JSON"],
      runtimePlatform: ["Python 3.11+", "Node.js 18+"],
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      author: { "@id": organization["@id"] },
      keywords: [
        "video generation",
        "AI",
        "ComfyUI",
        "LoRA",
        "multi-tenant",
        "long-form video",
        "ViMax",
        "Higgsfield",
        "reels",
        "open source",
      ],
    }
  : null;

const webPage = {
  "@type": "WebPage",
  "@id": canonical + "#webpage",
  url: canonical,
  name: fullTitle,
  description,
  inLanguage: "es",
  isPartOf: { "@id": webSite["@id"] },
  primaryImageOfPage: ogImageUrl,
  ...(publishedTime ? { datePublished: publishedTime } : {}),
  ...(modifiedTime ? { dateModified: modifiedTime } : {}),
};

const graph: Array<Record<string, unknown>> = [
  organization,
  webSite,
  ...(softwareSourceCode ? [softwareSourceCode] : []),
  webPage,
  ...extraJsonLd,
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1"
    />
    <meta name="theme-color" content="#050608" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonical} />

    <!-- LLM discovery (spec: https://llmstxt.org/) -->
    <link rel="alternate" type="text/plain" title="LLMs.txt site index" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="LLMs.txt full corpus" href="/llms-full.txt" />

    <!-- RSS — para feed readers y AI crawlers que descubren via feed -->
    <link rel="alternate" type="application/rss+xml" title="contenido · documentación (RSS)" href="/rss.xml" />

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="es_ES" />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === "article" && (
      <meta property="article:author" content="Elias Morales" />
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:creator" content={TWITTER_HANDLE} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..900,30..100;1,9..144,300..900,30..100&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <JsonLd data={graph} />

    <title>{fullTitle}</title>
  </head>
  <body class="relative">
    {showHeader && <Header />}
    <main class="relative z-[2]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
