# ==============================================================
# contenido — variables de entorno
# ==============================================================
# Cópia este archivo a `.env` y rellena valores.
# Las claves vacías se ignoran (loader usa config.toml como fallback).
# ==============================================================

# --- Entorno ---
CONTENIDO_ENV=dev                    # dev | staging | prod
DEFAULT_MODE=premium                 # express | premium
LOG_LEVEL=INFO

# --- Orquestación ---
ENABLE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
MAX_CONCURRENT_TASKS=3
MAX_QUEUED_TASKS=50

# --- AgentField (broker reasoners) ---
AGENT_NODE_ID=contenido
AGENTFIELD_SERVER=http://localhost:8080
AGENTFIELD_LLM_CALL_TIMEOUT=120

# ==============================================================
# LLM PROVIDERS — al menos uno requerido
# ==============================================================

# Premium default (de reels-af) — DeepSeek vía OpenRouter
OPENROUTER_API_KEY=

# Express default options
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL_NAME=gpt-35-turbo
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

MOONSHOT_API_KEY=
MOONSHOT_MODEL_NAME=moonshot-v1-8k

OLLAMA_MODEL_NAME=
OLLAMA_BASE_URL=http://localhost:11434/v1

QWEN_API_KEY=
QWEN_MODEL_NAME=qwen-max

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-chat

MIMO_API_KEY=
MIMO_MODEL_NAME=

GROQ_API_KEY=
GROQ_MODEL_NAME=

# Reels-af specific overrides (opcionales)
REEL_AF_MODEL=openrouter/deepseek/deepseek-v4-pro
REEL_AF_API_BASE=
REEL_AF_API_KEY=

# ==============================================================
# TTS PROVIDERS
# ==============================================================

# Edge TTS (gratis, default express) — no requiere key
EDGE_TTS_TIMEOUT=30

# Gemini Flash (default premium, tags inline)
REEL_AF_TTS_MODEL=google/gemini-3.1-flash-tts-preview

# Azure TTS
AZURE_TTS_API_KEY=
AZURE_TTS_REGION=eastus

# SiliconFlow CosyVoice2
SILICONFLOW_API_KEY=

# ==============================================================
# IMAGEN / VIDEO IA
# ==============================================================

REEL_AF_IMAGE_MODEL=openrouter/google/gemini-2.5-flash-image
REEL_AF_VIDEO_MODEL=openrouter/google/veo-3.1-lite
REEL_AF_USE_VEO=false              # true = Veo i2v; false = ken-burns

# --- Higgsfield Platform API (DoP + Soul + Effects) ---
# Una de las dos formas:
#   1) Combinado:   HIGGSFIELD_CREDENTIALS=KEY_ID:KEY_SECRET
#   2) Separado:    HIGGSFIELD_KEY_ID=... + HIGGSFIELD_KEY_SECRET=...
# Alias soportados (SDK oficial): HF_CREDENTIALS / HF_API_KEY / HF_API_SECRET
HIGGSFIELD_CREDENTIALS=
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
HIGGSFIELD_ENABLED=false           # true habilita DoP (reemplaza/complementa Veo)
HIGGSFIELD_SOUL_ENABLED=false      # true habilita Soul para first frames
HIGGSFIELD_EFFECTS_ENABLED=false   # true habilita action effects VFX
HIGGSFIELD_DOP_MODEL=dop-turbo     # dop-lite | dop-turbo | dop-preview
HIGGSFIELD_SOUL_MODEL=soul_cinematic
HIGGSFIELD_SOUL_REFERENCE_ID=      # SoulId default (opcional)
# CLI fallback (opt-in): si REST falla, intentar `higgsfield generate create ...`
HIGGSFIELD_CLI_FALLBACK=false
HIGGSFIELD_CLI_BINARY=higgsfield   # asume PATH; usar full path en prod
HIGGSFIELD_CLI_MODEL=seedance_2_0  # modelo canónico Higgsfield (SOTA)

# ==============================================================
# COMFYUI (LoRAs, ControlNet, AnimateDiff, IPAdapter)
# ==============================================================

COMFYUI_ENABLED=false                          # true → provider habilitado
COMFYUI_SERVER_URL=http://127.0.0.1:8188      # self-hosted o managed
COMFYUI_AUTH_HEADER=                           # para servicios managed
COMFYUI_WORKFLOWS_DIR=./workflows
COMFYUI_DEFAULT_WORKFLOW=                      # ej "flux_lora_brand"
COMFYUI_DEFAULT_TENANT=default
COMFYUI_PREFER_FOR_BRAND_FRAMES=true           # ComfyUI gana sobre Gemini/Soul cuando hay LoRA
COMFYUI_CLI_BINARY=comfy                       # comfy-cli binary
COMFYUI_CLI_WORKSPACE=                         # full path al workspace si custom

# ==============================================================
# STOCK FOOTAGE
# ==============================================================

# Pexels (rotación de keys: separar con coma)
PEXELS_API_KEYS=
# Pixabay
PIXABAY_API_KEYS=
# Coverr
COVERR_API_KEYS=

# ==============================================================
# DISTRIBUCIÓN
# ==============================================================

# Upload-Post (TikTok + Instagram)
UPLOAD_POST_API_KEY=
UPLOAD_POST_AUTO_UPLOAD=false
UPLOAD_POST_PLATFORMS=tiktok,instagram

# ==============================================================
# WHISPER (ASR)
# ==============================================================

WHISPER_MODEL_SIZE=large-v3        # tiny | base | small | medium | large | large-v3
WHISPER_DEVICE=cpu                 # cpu | cuda
WHISPER_COMPUTE_TYPE=int8          # int8 | int8_float16 | float16

# ==============================================================
# TLS / SEGURIDAD
# ==============================================================

TLS_VERIFY=true
